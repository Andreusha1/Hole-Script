main:AddToggle("Auto Item", getToggleDefault("Auto Item", false), function(value)
    AutoItem = value
    if not value then
        AutoItemBusy = false
        return
    end
    task.spawn(function()
        local lastActivity = tick()
        local workerRunning = false

        local function GetCharacter()
            local char = player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then return end
            return char, hum, root
        end

        local function CheckGiveMe()
            if not AutoItem then return end
            local success, label = pcall(function()
                return player.PlayerGui.HUD.TopButtons.GiveMeButtonHolder.GiveMePlate.Face.Content.Texts.Count.Label
            end)
            if not success or not label then return end
            local a = string.split(tostring(label.Text), "/")
            local current = tonumber(a[1])
            local max = tonumber(a[2])
            if not current or not max or current < GiveMeThreshold then return end

            local done = false
            task.spawn(function()
                pcall(function()
                    ReplicatedStorage.Remotes.HoleGiveMe:InvokeServer()
                end)
                done = true
            end)

            local timeout = tick() + 2
            while AutoItem and not done and tick() < timeout do
                lastActivity = tick()
                task.wait(0.05)
            end

            local waitUntil = tick() + 1
            while AutoItem and tick() < waitUntil do
                local ok, text = pcall(function()
                    return label.Text
                end)
                if ok then
                    local b = string.split(tostring(text), "/")
                    local newCurrent = tonumber(b[1])
                    if newCurrent and newCurrent < GiveMeThreshold then
                        break
                    end
                end
                lastActivity = tick()
                task.wait(0.05)
            end
        end

        local function GetItems(folder, strength, rootPosition)
            local items = {}
            local weightCap = math.min(tonumber(strength) or 0, AutoItemMaxWeight)
            for _, item in ipairs(folder:GetChildren()) do
                local weight = item:GetAttribute("Weight")
                local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                local prompt = item:FindFirstChild("PickupPrompt", true)
                local withinDistance = true
                if part and rootPosition then
                    withinDistance = (part.Position - rootPosition).Magnitude <= AutoItemMaxDistance
                end
                if typeof(weight) == "number"
                    and weight >= AutoItemMinWeight
                    and weight <= weightCap
                    and withinDistance
                    and part
                    and prompt
                    and prompt:IsA("ProximityPrompt") then
                    table.insert(items, {
                        Item = item,
                        Weight = weight,
                        Part = part,
                        Prompt = prompt,
                        Distance = rootPosition and (part.Position - rootPosition).Magnitude or math.huge
                    })
                end
            end
            table.sort(items, function(a, b)
                if AutoItemSortMode == "Cheapest" then
                    return a.Weight < b.Weight
                elseif AutoItemSortMode == "Nearest" then
                    return a.Distance < b.Distance
                elseif AutoItemSortMode == "Farthest" then
                    return a.Distance > b.Distance
                elseif AutoItemSortMode == "Balanced" then
                    local scoreA = a.Weight / math.max(a.Distance, 1)
                    local scoreB = b.Weight / math.max(b.Distance, 1)
                    return scoreA > scoreB
                end
                return a.Weight > b.Weight
            end)
            return items
        end

        local function GetAutoItemMovementSpeed(hum)
            if AutoItemSpeedMode == "Fixed" then
                return math.max(tonumber(AutoItemFixedSpeed) or 70, 1)
            end

            local walkSpeed = hum and tonumber(hum.WalkSpeed) or 16
            local reduction
            if walkSpeed > 100 then
                reduction = 30
            elseif walkSpeed >= 50 then
                reduction = 20
            elseif walkSpeed >= 30 then
                reduction = 10
            else
                reduction = 5
            end
            -- Preserve the tiered WalkSpeed deduction, then apply a slower travel multiplier.
            -- This affects Auto Item's interpolation only, not the character WalkSpeed itself.
            return math.max((walkSpeed - reduction) * 0.6, 1)
        end

        local function MoveSmooth(root, from, to)
            if not root or not root.Parent then return false end
            local hum = root.Parent:FindFirstChildOfClass("Humanoid")
            if not hum then return false end
            local current = from
            if (to - current).Magnitude <= 0.01 then return true end
            root.CFrame = CFrame.new(current)
            while AutoItem do
                if not root.Parent or player.Character ~= root.Parent then return false end
                hum = root.Parent:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then return false end
                local delta = to - current
                local distance = delta.Magnitude
                if distance <= 0.08 then
                    current = to
                    root.CFrame = CFrame.new(to)
                    break
                end
                local dt = RunService.Heartbeat:Wait()
                local step = GetAutoItemMovementSpeed(hum) * math.max(dt, 0)
                if step >= distance then
                    current = to
                else
                    current += delta.Unit * step
                end
                root.CFrame = CFrame.new(current)
                lastActivity = tick()
            end
            if not AutoItem or not root.Parent or player.Character ~= root.Parent then return false end
            root.CFrame = CFrame.new(to)
            lastActivity = tick()
            return true
        end

        local function MoveSmoothUnderground(root, targetPosition, depth)
            if not root or not root.Parent then return false end
            depth = math.max(tonumber(depth) or 18, 8)
            local startPosition = root.Position
            local undergroundY = math.min(startPosition.Y, targetPosition.Y) - depth
            local downPosition = Vector3.new(startPosition.X, undergroundY, startPosition.Z)
            local acrossPosition = Vector3.new(targetPosition.X, undergroundY, targetPosition.Z)
            if not MoveSmooth(root, startPosition, downPosition) then return false end
            if not AutoItem then return false end
            if not MoveSmooth(root, downPosition, acrossPosition) then return false end
            if not AutoItem then return false end
            return MoveSmooth(root, acrossPosition, targetPosition)
        end

        local function Worker()
            if workerRunning then return end
            workerRunning = true
            while AutoItem do
                local success = pcall(function()
                    lastActivity = tick()
                    CheckGiveMe()
                    if not AutoItem then return end
                    local char, hum, root = GetCharacter()
                    if not char or not hum or not root then
                        AutoItemBusy = false
                        task.wait(0.5)
                        return
                    end
                    local spawnedItems = workspace:FindFirstChild("SpawnedItems")
                    local strength = player:GetAttribute("Strength")
                    local assignedBase = tostring(player:GetAttribute("AssignedBase"))
                    if not spawnedItems or typeof(strength) ~= "number" then
                        AutoItemBusy = false
                        task.wait(0.5)
                        return
                    end
                    local map = workspace:FindFirstChild("0Map")
                    local base = map and map:FindFirstChild(assignedBase, true)
                    local baseHole = base and base:FindFirstChild("hole", true)
                    if not baseHole or not baseHole:IsA("BasePart") then
                        AutoItemBusy = false
                        task.wait(0.5)
                        return
                    end
                    local items = GetItems(spawnedItems, strength, root.Position)
                    local refresh = tick() + AutoItemRefreshInterval
                    while AutoItem do
                        lastActivity = tick()
                        char, hum, root = GetCharacter()
                        if not char or not hum or not root then
                            AutoItemBusy = false
                            break
                        end
                        if tick() >= refresh then
                            strength = player:GetAttribute("Strength")
                            if typeof(strength) ~= "number" then break end
                            items = GetItems(spawnedItems, strength, root.Position)
                            refresh = tick() + AutoItemRefreshInterval
                        end
                        local data = table.remove(items, 1)
                        if not data then
                            items = GetItems(spawnedItems, strength, root.Position)
                            task.wait(0.15)
                            continue
