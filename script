local AutoReconnect = false
local autoReconnectConnection
local reconnectBusy = false
local lastReconnectAttempt = 0
local sharedReconnectState = __OnrushaSharedEnv.__OnrushaReconnectState
if type(sharedReconnectState) ~= "table" or sharedReconnectState.session ~= __OnrushaSessionKey then
    sharedReconnectState = { session = __OnrushaSessionKey, busy = false, lastAttempt = 0 }
    __OnrushaSharedEnv.__OnrushaReconnectState = sharedReconnectState
end

local function isBanErrorMessage(message)
    local text = string.lower(tostring(message or ""))
    local markers = {
        "you are banned", "you were banned", "you have been banned", "banned from this experience",
        "permanently banned", "permanent ban", "ban appeal", "account terminated", "account deleted",
        "account has been moderated", "moderation action", "account moderation", "experience ban"
    }
    for _, marker in ipairs(markers) do
        if text:find(marker, 1, true) then
            return true
        end
    end
    return false
end

local function stopReconnectForBan(message)
    AutoReconnect = false
    reconnectBusy = false
    sharedReconnectState.busy = false
    SavedToggleState["Auto Reconnect"] = false
    saveToggleState()
    warn("[Onrusha] Auto Reconnect disabled because the error looks like a ban/moderation message:", tostring(message))
end

local function tryReconnect(errorMessage)
    if not AutoReconnect or reconnectBusy or sharedReconnectState.busy then
        return
    end

    if isBanErrorMessage(errorMessage) then
        stopReconnectForBan(errorMessage)
        return
    end

    local now = os.clock()
    local sharedLastAttempt = tonumber(sharedReconnectState.lastAttempt) or 0
    if now - math.max(lastReconnectAttempt, sharedLastAttempt) < 4 then
        return
    end

    lastReconnectAttempt = now
    sharedReconnectState.lastAttempt = now
    sharedReconnectState.busy = true
    reconnectBusy = true
    saveToggleState()
    queueReloadOnTeleport()

    task.spawn(function()
        task.wait(1)
        if not AutoReconnect then
            reconnectBusy = false
            sharedReconnectState.busy = false
            return
        end

        local ok, err = pcall(function()
            TeleportService:Teleport(game.PlaceId, player)
        end)

        if not ok then
            warn("[Onrusha] Reconnect attempt failed:", tostring(err))
            reconnectBusy = false
            sharedReconnectState.busy = false
            task.delay(4, function()
                if AutoReconnect then
                    tryReconnect("network retry")
                end
            end)
            return
        end

        -- Some failures are asynchronous; retry if teleport did not leave this server.
        task.delay(15, function()
            if AutoReconnect and reconnectBusy then
                reconnectBusy = false
                sharedReconnectState.busy = false
                tryReconnect("teleport timeout retry")
            end
        end)
    end)
end

-- ErrorMessageChanged is not exposed in every standard Roblox runtime; access it safely.
local errorSignalOK, errorMessageSignal = pcall(function()
    return GuiService.ErrorMessageChanged
end)
if errorSignalOK and errorMessageSignal then
    local connectOK, connectError = pcall(function()
        errorMessageSignal:Connect(function(errorMessage)
            if not AutoReconnect or type(errorMessage) ~= "string" or errorMessage == "" then
                return
            end
            tryReconnect(errorMessage)
        end)
    end)
    if not connectOK then
        warn("[Onrusha] Could not connect ErrorMessageChanged:", tostring(connectError))
    end
else
    warn("[Onrusha] GuiService.ErrorMessageChanged is unavailable; reconnect can only handle teleport failures.")
end

TeleportService.TeleportInitFailed:Connect(function(failedPlayer, teleportResult, errorMessage)
    if failedPlayer ~= player or not AutoReconnect then
        return
    end

    if isBanErrorMessage(errorMessage) then
        stopReconnectForBan(errorMessage)
        return
    end

    reconnectBusy = false
    sharedReconnectState.busy = false
    task.delay(4.5, function()
        if AutoReconnect then
            tryReconnect(errorMessage or tostring(teleportResult))
        end
    end)
end)

