local function GetItemWeightColor(weight)
    local alpha = math.clamp(weight / 75000, 0, 1)
    if alpha < 0.25 then
        local t = alpha / 0.25
        return Color3.new(t, 1, 0)
    elseif alpha < 0.5 then
        local t = (alpha - 0.25) / 0.25
        return Color3.new(1, 1 - t, 0)
    elseif alpha < 0.75 then
        local t = (alpha - 0.5) / 0.25
        return Color3.new(1, 0.5 - t * 0.5, 0)
    end
    local t = (alpha - 0.75) / 0.25
    return Color3.new(1 - t, 0, 0.5 + t * 0.5)
end

