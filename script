local LIBRARY_URL = "https://raw.githubusercontent.com/Andreusha1/OnrushaHub/refs/heads/main/script"
local VALIDATE_URL = "https://web-production-90f6b.up.railway.app/validate"
local Onrusha

do
    if type(loadstring) ~= "function" then
        error("[Onrusha] loadstring is unavailable in this environment")
    end

    local ok, result = pcall(function()
        local source = game:HttpGet(LIBRARY_URL)
        assert(type(source) == "string" and #source > 0, "Library source is empty")

        local function replaceOnce(text, oldText, newText, label)
            local first, last = string.find(text, oldText, 1, true)
            assert(first, "KeyGate compatibility patch could not find " .. label)
            return string.sub(text, 1, first - 1) .. newText .. string.sub(text, last + 1)
        end

        source = replaceOnce(
            source,
            'if result.valid == true then\n    return true, "valid", tonumber(result.expires_in) or 3600\nend',
            'if result.valid == true then\n    return true, "valid", tonumber(result.expires_in) or 3600, result.permanent == true\nend',
            "validation result handler"
        )
        source = replaceOnce(source, "local function finishKeyUnlock(key, expiresIn)", "local function finishKeyUnlock(key, expiresIn, isPermanent)", "unlock handler")
        source = replaceOnce(
            source,
            "local secondsLeft = math.max(1, math.floor(tonumber(expiresIn) or 3600))",
            "if isPermanent then return end\n\nlocal secondsLeft = math.max(1, math.floor(tonumber(expiresIn) or 3600))",
            "permanent expiry timer"
        )
        source = replaceOnce(source, "local callOK, valid, reason, expiresIn = pcall(validateKeyOnline, entered)", "local callOK, valid, reason, expiresIn, isPermanent = pcall(validateKeyOnline, entered)", "unlock validation result")
        source = source:gsub("finishKeyUnlock%(entered, expiresIn%)", "finishKeyUnlock(entered, expiresIn, isPermanent)")

        local chunk, compileError = loadstring(source)
        assert(type(chunk) == "function", tostring(compileError or "Library compilation failed"))
        return chunk()
    end)

    if not ok then
        error("[Onrusha] Failed to load library: " .. tostring(result))
    end

    assert(type(result) == "table" and type(result.Create) == "function", "Invalid Onrusha API")
    Onrusha = result
end

