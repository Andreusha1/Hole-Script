local legacyTabs = {}
local componentCounter = 0

local function makeControlId(name)
    componentCounter += 1
    local safeName = tostring(name):lower():gsub("[^%w]+", "_")
    return "legacy_" .. tostring(componentCounter) .. "_" .. safeName
end

local gui = {}

function gui:GetTab(name)
    name = tostring(name or "Main")
    if legacyTabs[name] then
        return legacyTabs[name]
    end

    local tab = ui:TabCreate({
        Name = name,
        Icon = name:sub(1, 1),
        Description = name .. " controls."
    })

    local isVisualTab = name:lower():find("visual", 1, true) ~= nil
    local general = tab:SectionCreate({
        Name = isVisualTab and "Item ESP" or "Automation",
        Side = "Left"
    })
    local extra = tab:SectionCreate({
        Name = isVisualTab and "Player ESP" or "Options",
        Side = "Right"
    })
    local legacyTab = {}

    function legacyTab:AddSlider(label, minValue, maxValue, defaultValue, callback, description)
        local min = tonumber(minValue) or 0
        local max = tonumber(maxValue) or 100
        local default = tonumber(defaultValue) or min
        local component = general:SliderCreate({
            Id = makeControlId(label),
            Name = tostring(label),
            Description = description or ("Adjust " .. tostring(label) .. "."),
            Min = min,
            Max = max,
            Default = math.clamp(default, min, max),
            Step = 1
        })
        if type(callback) == "function" then
            component:OnChanged(callback)
        end
        return component
    end

    function legacyTab:AddToggle(label, defaultValue, callback, description, settingsBuilder)
        local lowerName = tostring(label):lower()
        local targetSection = general
        if lowerName == "player esp" or lowerName:find("punch", 1, true) then
            targetSection = extra
        end

        local component = targetSection:ToggleCreate({
            Id = makeControlId(label),
            Name = tostring(label),
            Description = description or ("Toggle " .. tostring(label) .. "."),
            Default = defaultValue == true
        })

        local function applyToggle(value)
            SavedToggleState[tostring(label)] = value == true
            saveToggleState()
            if type(callback) == "function" then
                callback(value == true)
            end
        end

        component:OnChanged(applyToggle)

        if type(settingsBuilder) == "function" then
            local settingsTarget
            local settingsSetupOK, settingsSetupError = pcall(function()
                if lowerName == "auto give me" or lowerName == "auto lift" then
                    settingsTarget = component:CreateSettings({ Name = tostring(label) .. " Settings" })
                elseif lowerName == "auto item" then
                    settingsTarget = {
                        Movement = tab:SectionCreate({ Name = "Auto Item Movement", Side = "Left" }),
                        Filter = tab:SectionCreate({ Name = "Item Filter", Side = "Right" })
                    }
                else
                    settingsTarget = targetSection
                end
            end)
            if not settingsSetupOK then
                warn("[Onrusha] Could not prepare settings for " .. tostring(label) .. ": " .. tostring(settingsSetupError))
            elseif settingsTarget then
                local builderOK, builderError = pcall(settingsBuilder, settingsTarget)
                if not builderOK then
                    warn("[Onrusha] Could not create settings for " .. tostring(label) .. ": " .. tostring(builderError))
                end
            end
        end

        if defaultValue == true then
            task.defer(applyToggle, true)
        end

        return component
    end

    legacyTabs[name] = legacyTab
    return legacyTab
end

