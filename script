local SavedToggleState = {}
local function loadToggleState()
    for _, env in ipairs(getEnvironments()) do
        if type(env.readfile) == "function" and type(env.isfile) == "function" then
            local existsOK, exists = pcall(env.isfile, TOGGLE_STATE_FILE)
            if existsOK and exists then
                local readOK, contents = pcall(env.readfile, TOGGLE_STATE_FILE)
                if readOK and type(contents) == "string" then
                    local decodeOK, decoded = pcall(function() return HttpService:JSONDecode(contents) end)
                    if decodeOK and type(decoded) == "table" then
                        SavedToggleState = decoded
                        return
                    end
                end
            end
        end
        if type(env.OnrushaAutoFarmState) == "table" then
            SavedToggleState = table.clone(env.OnrushaAutoFarmState)
            return
        end
    end
end

loadToggleState()

local function saveToggleState()
    for _, env in ipairs(getEnvironments()) do
        if type(env.writefile) == "function" then
            pcall(env.writefile, TOGGLE_STATE_FILE, HttpService:JSONEncode(SavedToggleState))
        end
        pcall(function() env.OnrushaAutoFarmState = table.clone(SavedToggleState) end)
    end
end

